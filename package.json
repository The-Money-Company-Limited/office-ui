{
  "name": "extend-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Extend"
  },
  "workspaces": [
    "apps/*",
    "engines/*",
    "engines/react-docx/packages/*",
    "engines/react-xlsx/packages/*",
    "engines/react-pptx/packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=v4...",
    "dev": "turbo run dev --parallel --filter=v4",
    "v4:dev": "pnpm --filter=v4 dev",
    "v4:build": "pnpm --filter=v4 build",
    "v4:registry:build": "pnpm --filter=v4 registry:build",
    "v4:registry:validate": "pnpm --filter=v4 registry:validate",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck format:check"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "turbo": "^1.9.9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "lodash": "4.18.1",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "esbuild": "0.28.1",
      "react-docx-monorepo>vite": "6.4.2"
    },
    "patchedDependencies": {
      "@chenglou/pretext@0.0.8": "engines/react-docx/patches/@chenglou__pretext@0.0.8.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
