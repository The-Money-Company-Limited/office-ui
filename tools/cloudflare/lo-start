#!/bin/bash
# Starts LibreOffice listening for URP on port 2002, where the duke-sheets tests look for it before
# they try Docker, which the box doesn't have, and restarts it if it dies, as the tests' Docker
# image does. Returns once it accepts connections. `lo-start --restart` replaces a running one.
up() { : </dev/tcp/127.0.0.1/2002; } 2>/dev/null
# LibreOffice's processes, found by executable (their command lines are no help).
office() {
  for p in /proc/[0-9]*; do
    case "$(readlink "$p/exe" 2>/dev/null)" in */program/soffice.bin | */program/oosplash) echo "${p#/proc/}" ;; esac
  done
}
# One lo-start at a time on the shared box, so two never start two LibreOffices.
exec 9>/tmp/lo-start.lock
flock 9
if [ "$1" = --restart ]; then
  [ -f /tmp/soffice.pid ] && kill -- "-$(cat /tmp/soffice.pid)" 2>/dev/null
  kill $(office) 2>/dev/null
  for _ in $(seq 30); do up || break; sleep 1; done
fi
up && exit 0
setsid nohup bash -c 'while :; do
  soffice --headless --norestore --nologo --accept="socket,host=127.0.0.1,port=2002;urp;StarOffice.ComponentContext"
  sleep 1
done' >/tmp/soffice.log 2>&1 </dev/null 9>&- &
echo $! >/tmp/soffice.pid
for _ in $(seq 60); do
  up && exit 0
  sleep 1
done
echo "LibreOffice didn't start within 60 s; see /tmp/soffice.log on the box." >&2
exit 1
