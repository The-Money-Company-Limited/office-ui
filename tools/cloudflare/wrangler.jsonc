{
  "$schema": "https://unpkg.com/wrangler@4.157.0/config-schema.json",
  "name": "office-builds",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Builder",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BUILDER", "class_name": "Builder" }]
  },
  "exports": {
    "Builder": { "type": "durable-object", "storage": "sqlite" }
  }
}
